---
// src/components/HeroBanner.astro
import { siteConfig } from '../config/site.js';

const waMessage = encodeURIComponent(`Hi ${siteConfig.name}! 💨 I'm looking for premium vapes in Hyderabad.`);
const waLink = `https://wa.me/${siteConfig.whatsappNumber}?text=${waMessage}`;

// SLIDER DATA WITH SEO KEYWORDS
const slides = [
  {
    id: 1,
    badge: "⚡ 30-Min Delivery",
    title: "Best <span class='highlight'>Vape Shop Hyderabad</span>",
    subtitle: "Looking for top <strong>vapes in hyderabad</strong>? We deliver authentic disposable vapes right to your doorstep.",
    img: "https://vapeshopkolkata.com/wp-content/uploads/2026/09/ALFABAR-TETLI-280x300.avif",
    bgClass: "bg-slide-1"
  },
  {
    id: 2,
    badge: "🔥 Trending Collection",
    title: "Premium <span class='highlight'>Vape Store Hyderabad</span>",
    subtitle: "Your trusted <strong>online vape in hyderabad</strong> destination. 100% genuine e-liquids and pods.",
    img: "https://vapeshopkolkata.com/wp-content/uploads/2026/09/ALFABAR-TETLI-280x300.avif", 
    bgClass: "bg-slide-2"
  },
  {
    id: 3,
    badge: "🛡️ 100% Authentic",
    title: "Explore <span class='highlight'>Vape Hyderabad</span>",
    subtitle: "Experience the ultimate <strong>vape shop hyderabad</strong> service. Fast, discreet, and reliable.",
    img: "https://vapeshopkolkata.com/wp-content/uploads/2026/09/ALFABAR-TETLI-280x300.avif",
    bgClass: "bg-slide-3"
  }
];
---

<!-- Invisible SEO H1 containing focus keywords -->
<h1 class="sr-only">Top Vape Shop Hyderabad - Buy Online Vape in Hyderabad</h1>

<!-- Isolation wrapper fixes the right-side gap issue permanently -->
<div class="hero-isolation-wrapper">
  <section class="flipkart-slider-section">
    
    <div class="slider-container" id="hero-slider">
      
      <!-- Track holding all slides -->
      <div class="slider-track" id="slider-track">
        {slides.map((slide, index) => (
          <div class="slide" data-index={index}>
            
            <div class={`banner-bg ${slide.bgClass}`}></div>

            <div class="banner-content">
              <div class="badge">
                <span class="pulse-dot"></span>
                {slide.badge}
              </div>
              
              <h2 class="banner-title" set:html={slide.title}></h2>
              <p class="banner-subtitle" set:html={slide.subtitle}></p>
              
              <a href={waLink} target="_blank" rel="noopener noreferrer" class="whatsapp-btn">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.82 9.82 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
                Order Now
              </a>
            </div>

            <div class="banner-image-wrapper">
              <img src={slide.img} alt="Vape shop in hyderabad" class="banner-product-img" loading="lazy" />
            </div>
            
          </div>
        ))}
      </div>

      <!-- Pagination Indicators (Dots) -->
      <div class="slider-dots" id="slider-dots">
        {slides.map((_, index) => (
          <button class={`dot ${index === 0 ? 'active' : ''}`} data-index={index} aria-label={`Slide ${index + 1}`}></button>
        ))}
      </div>

    </div>
  </section>
</div>

<style>
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border-width: 0; }

  /* HARD LOCK FOR NO HORIZONTAL SCROLL/GAP */
  .hero-isolation-wrapper {
    width: 100%; max-width: 100vw;
    overflow: hidden; box-sizing: border-box;
    display: block; clear: both;
  }

  .flipkart-slider-section {
    width: 100%; max-width: 1200px;
    margin: 16px auto 30px;
    padding: 0 12px; box-sizing: border-box;
    font-family: system-ui, -apple-system, sans-serif;
  }
  @media (min-width: 768px) { .flipkart-slider-section { padding: 0 24px; margin-top: 24px; } }

  .slider-container {
    position: relative; width: 100%; 
    min-height: 200px; border-radius: 20px; overflow: hidden;
    background: #000; box-shadow: 0 10px 30px rgba(0,0,0,0.4);
    display: block; box-sizing: border-box;
  }
  @media (min-width: 768px) { .slider-container { min-height: 280px; border-radius: 30px; } }

  .slider-track {
    display: flex; width: 100%; height: 100%;
    transition: transform 0.5s cubic-bezier(0.25, 1, 0.5, 1);
    will-change: transform;
    touch-action: pan-y; /* Allows vertical page scroll, captures horizontal swipe */
  }

  /* INDIVIDUAL SLIDE (Horizontal Layout) */
  .slide {
    flex: 0 0 100%; min-width: 100%; position: relative;
    display: flex; flex-direction: row; align-items: center;
    box-sizing: border-box;
  }

  .banner-bg {
    position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 1;
  }
  .bg-slide-1 { background: radial-gradient(circle at 80% 50%, #2a0d17 0%, #0d0d0d 80%); }
  .bg-slide-2 { background: radial-gradient(circle at 80% 50%, #0d1e2a 0%, #0d0d0d 80%); }
  .bg-slide-3 { background: radial-gradient(circle at 80% 50%, #1a2a0d 0%, #0d0d0d 80%); }

  /* CONTENT LEFT */
  .banner-content {
    position: relative; z-index: 3; flex: 1.2;
    padding: 20px 16px 36px; /* Extra bottom padding for dots */
    display: flex; flex-direction: column; align-items: flex-start;
  }
  @media (min-width: 768px) { .banner-content { padding: 40px 40px; } }

  .badge {
    display: inline-flex; align-items: center; gap: 6px;
    background: rgba(37, 211, 102, 0.1); color: #25D366;
    padding: 4px 10px; border-radius: 20px; font-size: 0.65rem; font-weight: 700;
    margin-bottom: 8px; border: 1px solid rgba(37, 211, 102, 0.2);
  }
  .pulse-dot { width: 6px; height: 6px; background-color: #25D366; border-radius: 50%; }

  .banner-title {
    font-size: 1.25rem; line-height: 1.2; margin: 0 0 6px 0;
    color: #ffffff; font-weight: 800; letter-spacing: -0.5px;
  }
  @media (min-width: 768px) { .banner-title { font-size: 3rem; margin-bottom: 12px; } }
  :global(.highlight) { color: #ff3e6c; }

  .banner-subtitle { font-size: 0.75rem; color: #bbb; margin: 0 0 16px 0; line-height: 1.4; }
  @media (min-width: 768px) { .banner-subtitle { font-size: 1.1rem; margin-bottom: 24px; } }
  :global(.banner-subtitle strong) { color: #fff; font-weight: 600; } 

  .whatsapp-btn {
    background: #25D366; color: #000; text-decoration: none;
    padding: 8px 16px; border-radius: 12px; font-weight: 800; font-size: 0.8rem;
    display: flex; align-items: center; gap: 6px; box-shadow: 0 4px 15px rgba(37, 211, 102, 0.3);
  }
  .whatsapp-btn:active { transform: scale(0.95); }

  /* IMAGE RIGHT */
  .banner-image-wrapper {
    position: relative; z-index: 2; flex: 0.8; height: 100%; 
    display: flex; justify-content: center; align-items: center; padding: 10px;
  }

  .banner-product-img {
    width: 100%; max-width: 140px; height: auto; max-height: 160px;
    object-fit: contain; filter: drop-shadow(0 15px 15px rgba(0,0,0,0.6));
    transform: scale(1.1) rotate(-5deg);
  }
  @media (min-width: 768px) { .banner-product-img { max-width: 250px; max-height: 250px; } }

  /* DOTS */
  .slider-dots {
    position: absolute; bottom: 10px; left: 0; width: 100%;
    display: flex; justify-content: center; gap: 6px; z-index: 10;
  }
  .dot {
    width: 16px; height: 4px; background: rgba(255, 255, 255, 0.3);
    border: none; border-radius: 4px; padding: 0; margin: 0; transition: all 0.3s;
  }
  .dot.active { background: #ff3e6c; width: 28px; }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const track = document.getElementById('slider-track');
    if (!track) return;
    
    const slides = document.querySelectorAll('.slide');
    const dots = document.querySelectorAll('.dot');
    const totalSlides = slides.length;
    let currentIndex = 0;
    let autoPlayTimer;

    function updateSlider(index) {
      if (index < 0) index = totalSlides - 1;
      if (index >= totalSlides) index = 0;
      currentIndex = index;
      
      const offset = -(currentIndex * 100);
      track.style.transform = `translateX(${offset}%)`;

      dots.forEach(dot => dot.classList.remove('active'));
      if(dots[currentIndex]) dots[currentIndex].classList.add('active');
    }

    function nextSlide() { updateSlider(currentIndex + 1); }
    function prevSlide() { updateSlider(currentIndex - 1); }

    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => { updateSlider(index); resetAutoPlay(); });
    });

    function startAutoPlay() { autoPlayTimer = setInterval(nextSlide, 3000); }
    function resetAutoPlay() { clearInterval(autoPlayTimer); startAutoPlay(); }

    // Swipe logic
    let touchStartX = 0;
    let touchEndX = 0;

    track.addEventListener('touchstart', e => {
      touchStartX = e.changedTouches[0].screenX;
      clearInterval(autoPlayTimer);
    }, {passive: true});

    track.addEventListener('touchend', e => {
      touchEndX = e.changedTouches[0].screenX;
      const swipeThreshold = 40;
      if (touchEndX < touchStartX - swipeThreshold) nextSlide();
      if (touchEndX > touchStartX + swipeThreshold) prevSlide();
      startAutoPlay();
    }, {passive: true});

    startAutoPlay();
  });
</script>