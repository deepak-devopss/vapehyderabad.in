---
// src/pages/cart.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site.js';
---

<BaseLayout title="Cart" description="Complete your premium vape purchase.">
  <div class="native-app-wrapper">
    
    <!-- App Header (Fixed: Removed 3 lines menu, centered title) -->
    <header class="app-header">
      <button class="icon-btn back-btn" onclick="history.back()" aria-label="Go Back">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
      </button>
      <h1 class="header-title">Cart</h1>
      <div style="width: 40px;"></div> <!-- Spacer to keep title perfectly centered -->
    </header>

    <!-- Empty State -->
    <div id="empty-cart" class="empty-state" style="display: none;">
      <div class="empty-cart-icon">🛒</div>
      <h2>Your cart is empty</h2>
      <p>Explore our premium collection and add some vapes.</p>
      <a href="/shop" class="explore-btn">Browse Collection</a>
    </div>

    <!-- Main Cart Content -->
    <div id="cart-content" style="display: none;">
      
      <!-- Cart Items Unified Card -->
      <div class="app-card items-card">
        <ul id="cart-list" class="cart-list">
          <!-- JS will inject items here -->
        </ul>
      </div>

      <!-- Billing Details Card -->
      <div class="app-card billing-card">
        <div class="promo-row">
          <input type="text" placeholder="Enter Promocode" class="promo-input" />
          <button class="apply-btn">Apply</button>
        </div>
        
        <div class="divider"></div>

        <div class="bill-row">
          <span class="bill-label">Subtotal:</span>
          <span id="item-total-amount" class="bill-val">₹0</span>
        </div>
        <div class="bill-row">
          <span class="bill-label">Delivery Fee:</span>
          <span class="bill-val free-text">FREE</span>
        </div>
        <div class="bill-row">
          <span class="bill-label">Discount:</span>
          <span class="bill-val">₹0</span>
        </div>
      </div>
      
    </div>
  </div>

  <!-- Full Width Floating Checkout Button -->
  <div id="bottom-checkout-bar" class="checkout-dock" style="display: none;">
    <button id="whatsapp-checkout-btn" class="checkout-pill-btn">
      Checkout for <span id="bottom-total-amount">₹0</span>
    </button>
  </div>
</BaseLayout>

<!-- STATIC STYLES -->
<style>
  :global(.mobile-nav-wrapper) { display: none !important; }

  /* STOP ZOOM ON DOUBLE TAP FOR ALL INTERACTIVE ELEMENTS */
  button, a, input {
    touch-action: manipulation; /* This is the magic fix for rapid tapping */
    user-select: none;
    -webkit-user-select: none;
  }

  .native-app-wrapper {
    max-width: 600px; margin: 0 auto; padding: 16px 16px 140px; 
    font-family: system-ui, -apple-system, sans-serif;
    background-color: #000; min-height: 100vh;
  }
  
  .app-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; padding-top: 8px; }
  .icon-btn { background: #1a1a1a; border: none; color: #fff; width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: transform 0.1s;}
  .icon-btn:active { transform: scale(0.9); }
  .header-title { font-size: 1.2rem; font-weight: 600; color: #fff; margin: 0; }

  .app-card { background: #141414; border-radius: 24px; padding: 16px; margin-bottom: 16px; border: 1px solid rgba(255, 255, 255, 0.03); }

  /* Billing Card */
  .promo-row { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .promo-input { flex-grow: 1; background: transparent; border: none; color: #fff; font-size: 0.95rem; outline: none; }
  .promo-input::placeholder { color: #666; }
  .apply-btn { background: none; border: none; color: #ff3e6c; font-weight: 700; font-size: 0.9rem; cursor: pointer; }

  .divider { height: 1px; background: rgba(255,255,255,0.06); margin: 16px 0; }
  .bill-row { display: flex; justify-content: space-between; margin-bottom: 12px; font-size: 0.9rem; }
  .bill-row:last-child { margin-bottom: 0; }
  .bill-label { color: #888; }
  .bill-val { color: #fff; font-weight: 600; }
  .free-text { color: #25D366; }

  /* Floating Dock */
  .checkout-dock {
    position: fixed; bottom: 0; left: 0; width: 100%;
    background: linear-gradient(to top, rgba(0,0,0,1) 60%, rgba(0,0,0,0));
    padding: 24px 16px; padding-bottom: calc(24px + env(safe-area-inset-bottom));
    z-index: 1000; display: flex; justify-content: center;
  }
  .checkout-pill-btn {
    width: 100%; max-width: 600px; background: #ff3e6c; color: #fff; border: none; 
    padding: 18px 24px; border-radius: 30px; font-size: 1.1rem; font-weight: 700;
    display: flex; justify-content: center; align-items: center; gap: 8px; cursor: pointer; 
    box-shadow: 0 10px 20px rgba(255, 62, 108, 0.3);
    transition: transform 0.1s;
  }
  .checkout-pill-btn:active { transform: scale(0.96); }

  /* Empty State */
  .empty-state { text-align: center; padding: 80px 20px; }
  .empty-cart-icon { font-size: 4rem; margin-bottom: 16px; filter: grayscale(100%) opacity(0.5); }
  .empty-state h2 { color: #fff; font-size: 1.3rem; margin: 0 0 8px; }
  .empty-state p { color: #888; font-size: 0.9rem; margin: 0 0 24px; }
  .explore-btn { display: inline-block; padding: 14px 28px; background: #fff; color: #000; text-decoration: none; border-radius: 16px; font-weight: 700; font-size: 0.95rem; }
</style>

<!-- DYNAMIC GLOBAL STYLES -->
<style is:global>
  .cart-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 16px; }
  .cart-item { 
    display: flex; flex-direction: row; align-items: center; gap: 12px; 
    padding-bottom: 16px; border-bottom: 1px solid rgba(255,255,255,0.05); width: 100%; 
  }
  .cart-item:last-child { border-bottom: none; padding-bottom: 0; }
  
  .fake-checkbox {
    width: 20px; height: 20px; flex-shrink: 0; background: #ff3e6c; border-radius: 6px;
    display: flex; justify-content: center; align-items: center;
  }
  .fake-checkbox::after { content: '✓'; color: #fff; font-size: 12px; font-weight: bold; }

  /* Strict Image Container */
  .item-img-container {
    width: 70px !important; height: 70px !important; 
    min-width: 70px !important; max-width: 70px !important;
    flex-shrink: 0 !important; background: #ffffff; 
    border-radius: 12px; display: flex; align-items: center; justify-content: center;
    overflow: hidden; border: 1px solid rgba(255,255,255,0.1);
  }
  .item-img-container img { width: 100% !important; height: 100% !important; object-fit: contain !important; display: block; padding: 4px; pointer-events: none; }
  .item-img-container span { font-size: 2rem; pointer-events: none; }
  
  .item-details { flex: 1; display: flex; flex-direction: column; justify-content: center; gap: 6px; min-width: 0; }
  .item-title { margin: 0; font-size: 0.95rem; color: #fff; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  
  .price-stepper-row { display: flex; justify-content: space-between; align-items: center; }
  .item-price { color: #fff; font-weight: 700; font-size: 0.95rem; }

  .circular-stepper { display: flex; align-items: center; gap: 8px; }
  .stepper-btn { 
    background: #2a2a2a; border: none; color: #fff; width: 32px; height: 32px; /* Thoda bada banaya for easy tapping */
    border-radius: 50%; display: flex; align-items: center; justify-content: center; 
    cursor: pointer; transition: background 0.1s;
    touch-action: manipulation; /* Anti-zoom property */
  }
  .stepper-btn:active { background: #444; }
  .stepper-btn.trash-btn { color: #ff3e6c; background: rgba(255, 62, 108, 0.1); } /* Trash button gets red tint */
  .stepper-btn.trash-btn:active { background: rgba(255, 62, 108, 0.2); }
  .stepper-count { color: #fff; font-weight: 700; font-size: 0.95rem; min-width: 20px; text-align: center; }
</style>

<script define:vars={{ waNumber: siteConfig.whatsappNumber, brandName: siteConfig.name }}>
  
  function loadCartUI() {
    const cart = JSON.parse(localStorage.getItem('vapeCart')) || [];
    const emptyState = document.getElementById('empty-cart');
    const cartContent = document.getElementById('cart-content');
    const bottomBar = document.getElementById('bottom-checkout-bar');
    const cartList = document.getElementById('cart-list');
    
    if (cart.length === 0) {
      emptyState.style.display = 'block';
      cartContent.style.display = 'none';
      bottomBar.style.display = 'none';
      return;
    }

    emptyState.style.display = 'none';
    cartContent.style.display = 'block';
    bottomBar.style.display = 'flex';
    cartList.innerHTML = '';

    let grandTotal = 0;

    cart.forEach((item, index) => {
      grandTotal += item.price * item.quantity;
      
      // TRASH ICON SVG logic when quantity is 1
      const minusIcon = item.quantity === 1 
        ? `<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>`
        : `<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line></svg>`;
      
      const trashClass = item.quantity === 1 ? 'trash-btn' : '';

      const imageHtml = item.image.includes('http') || item.image.includes('/')
        ? `<img src="${item.image}" alt="${item.name}" loading="lazy" />`
        : `<span>${item.image}</span>`;

      const li = document.createElement('li');
      li.className = 'cart-item';
      li.innerHTML = `
        <div class="fake-checkbox"></div>
        <div class="item-img-container">${imageHtml}</div>
        <div class="item-details">
          <h3 class="item-title">${item.name}</h3>
          <div class="price-stepper-row">
            <span class="item-price">₹${item.price}</span>
            <div class="circular-stepper">
              <button class="stepper-btn ${trashClass} minus-btn" data-index="${index}" aria-label="Decrease quantity">${minusIcon}</button>
              <span class="stepper-count">${item.quantity}</span>
              <button class="stepper-btn plus-btn" data-index="${index}" aria-label="Increase quantity">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
              </button>
            </div>
          </div>
        </div>
      `;
      cartList.appendChild(li);
    });

    document.getElementById('item-total-amount').innerText = `₹${grandTotal}`;
    document.getElementById('bottom-total-amount').innerText = `₹${grandTotal}`;

    attachCartEvents();
  }

  function updateCart(index, action) {
    if(index === undefined) return;
    let cart = JSON.parse(localStorage.getItem('vapeCart')) || [];
    
    try {
      const ctx = new (window.AudioContext || window.webkitAudioContext)();
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.connect(gain); gain.connect(ctx.destination);
      osc.frequency.setValueAtTime(action === 'plus' ? 800 : 400, ctx.currentTime);
      gain.gain.setValueAtTime(0.05, ctx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.1);
      osc.start(ctx.currentTime); osc.stop(ctx.currentTime + 0.1);
    } catch(e) {}

    if (action === 'plus') {
      cart[index].quantity += 1;
    } else if (action === 'minus') {
      if (cart[index].quantity > 1) {
        cart[index].quantity -= 1;
      } else {
        cart.splice(index, 1); 
      }
    }
    
    localStorage.setItem('vapeCart', JSON.stringify(cart));
    window.dispatchEvent(new Event('cartUpdated')); 
    loadCartUI(); 
  }

  function attachCartEvents() {
    document.querySelectorAll('.plus-btn').forEach(btn => {
      btn.addEventListener('click', (e) => updateCart(e.currentTarget.dataset.index, 'plus'));
    });
    document.querySelectorAll('.minus-btn').forEach(btn => {
      btn.addEventListener('click', (e) => updateCart(e.currentTarget.dataset.index, 'minus'));
    });
  }

  document.getElementById('whatsapp-checkout-btn')?.addEventListener('click', () => {
    const cart = JSON.parse(localStorage.getItem('vapeCart')) || [];
    let message = `*New Order for ${brandName}* 🛍️\n\n*Order Details:*\n`;
    let total = 0;

    cart.forEach((item) => {
      const itemTotal = item.price * item.quantity;
      total += itemTotal;
      message += `▪️ ${item.quantity}x ${item.name} - ₹${itemTotal}\n`;
    });

    message += `\n💰 *Total Amount: ₹${total}*\n\nPlease confirm my order and share payment details.`;
    
    const waUrl = `https://wa.me/${waNumber}?text=${encodeURIComponent(message)}`;
    window.open(waUrl, '_blank');
  });

  document.addEventListener("DOMContentLoaded", loadCartUI);
</script>