---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import HeroBanner from '../components/HeroBanner.astro';
import CategorySlider from '../components/CategorySlider.astro';
import ProductGrid from '../components/ProductGrid.astro';
import BrandShowcase from '../components/BrandShowcase.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import RichTextWithImage from '../components/RichTextWithImage.astro';
import LocalAreas from '../components/LocalAreas.astro';
import FAQ from '../components/FAQ.astro';


// 🔥 APNA NAYA TITLE YAHAN DALIYE 🔥
const pageTitle = "Vape Shop Hyderabad - 30 Min Express Vape Delivery in Hyderabad";
const pageDescription = "Looking to buy premium disposable vapes, pods, and e-liquids in Hyderabad? VAPEHYD offers 100% authentic products with instant 30-minute delivery.";

// JSON-LD Schema for Local Business (Aapki SEO rank boost karne ke liye)
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Vape Hyderabad",
  "image": "https://vapehyderabad.in/logo.png", // Apna actual logo link baad mein update karein
  "url": "https://vapehyderabad.in",
  "telephone": "+919718075675", // Apna actual number
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Hyderabad City",
    "addressLocality": "Hyderabad",
    "addressRegion": "TS",
    "postalCode": "500001",
    "addressCountry": "IN"
  },
  "priceRange": "₹₹"
};
---

<!-- 🔥 Galti yahan thi, ab ye sahi ho gaya hai 🔥 -->
<BaseLayout title={pageTitle} description={pageDescription}>
  
  <!-- SEO Schema Injection -->
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />

  <!-- Hero Section -->
  
  <HeroBanner />

  <AnnouncementBar />

  <CategorySlider />

  <ProductGrid />

  <!-- Elfbar Showcase (Slider Style) -->
  <BrandShowcase 
    brandName="Elfbar" 
    title="Elfbar Exclusives ✨" 
    subtitle="The most loved disposable pods" 
  />

  <WhyChooseUs />

  <RichTextWithImage />

  <LocalAreas />

  <FAQ />
  
</BaseLayout>