---
// src/pages/product/[slug].astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro'; // 🔥 Related Products ke liye Import kiya
import products from '../../data/products.json';
import { siteConfig } from '../../config/site.js';

export async function getStaticPaths() {
  return products.map((product) => {
    const slug = product.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, '');
    return {
      params: { slug },
      props: { product }
    };
  });
}

const { product } = Astro.props;
const categorySlug = product.category ? product.category.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, '') : 'uncategorized';

// Flavors & Description Logic
let flavorsArray = [];
if (product.variants) {
  if (Array.isArray(product.variants)) {
    flavorsArray = product.variants;
  } else if (typeof product.variants === 'string') {
    flavorsArray = product.variants.split(',').map(f => f.trim()).filter(Boolean);
  }
}

const longDescription = product.long_description || product.short_description || '';

// 🔥 RELATED PRODUCTS LOGIC: Same category ke max 4 products dikhayenge (Current product ko hata kar)
const relatedProducts = products
  .filter(p => p.category === product.category && p.id !== product.id)
  .slice(0, 4);

// 🔥 DYNAMIC PRODUCT-SPECIFIC FAQS (SEO)
const productFAQs = [
  { q: `Is the ${product.name} 100% authentic?`, a: `Yes, absolutely! At VAPEHYD, we guarantee that the ${product.name} by ${product.brand || 'our premium brands'} is 100% genuine and verified. It comes with an authenticity scratch code.` },
  { q: `How fast is the delivery for ${product.name} in Hyderabad?`, a: `We offer lightning-fast hyperlocal delivery. You can get your ${product.name} delivered anywhere in Hyderabad within 30 to 45 minutes.` },
  { q: `What makes ${product.brand || 'this'} ${product.category ? product.category.toLowerCase() : 'vape'} better?`, a: `${product.brand || 'This brand'} is globally recognized for its premium build quality, consistent flavor, and long-lasting battery life.` },
  { q: `Can I pay using Cash on Delivery for this item?`, a: `Yes, we offer secure Cash on Delivery (COD) as well as instant UPI payment options for all orders in Hyderabad.` }
];

const title = `${product.name} - Buy Online in Hyderabad | VAPEHYD`;
const description = `Buy 100% authentic ${product.name} at just ₹${product.sale_price} in Hyderabad. Order now for 30-minute delivery.`;

// SEO Schemas
const randomReviewCount = Math.floor(Math.random() * (85 - 15 + 1) + 15); // Generates a random number between 15 and 85

const productSchema = {
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": product.name,
  "image": product.image && product.image.includes('http') ? product.image : `${siteConfig.url}/assets/placeholder.jpg`,
  "description": longDescription.replace(/(<([^>]+)>)/gi, ""), // Tags remove karke clean text for Google
  "sku": `VAPEHYD-${product.id}`, // Missing SKU error fix
  "mpn": `MPN-${product.id}`, // Manufacturer Part Number fix
  "brand": { 
    "@type": "Brand", 
    "name": product.brand || 'VAPEHYD' 
  },
  // 🔥 Ye Google Search me aapke product ke aage 5-Stars dikhayega! (Massive CTR Boost)
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.8",
    "reviewCount": String(randomReviewCount)
  },
  "offers": {
    "@type": "Offer",
    "url": `${siteConfig.url}/product/${Astro.params.slug}`,
    "priceCurrency": "INR",
    "price": product.sale_price,
    "priceValidUntil": "2027-12-31", // Missing priceValidUntil error fix
    "availability": "https://schema.org/InStock",
    "itemCondition": "https://schema.org/NewCondition",
    
    // 🔥 Merchant Listing: Shipping Details (Google demands this now)
    "shippingDetails": {
      "@type": "OfferShippingDetails",
      "shippingRate": {
        "@type": "MonetaryAmount",
        "value": "0", // Free delivery
        "currency": "INR"
      },
      "deliveryTime": {
        "@type": "ShippingDeliveryTime",
        "handlingTime": { "@type": "QuantitativeValue", "minValue": 0, "maxValue": 0, "unitCode": "d" },
        "transitTime": { "@type": "QuantitativeValue", "minValue": 0, "maxValue": 1, "unitCode": "d" }
      }
    },
    // 🔥 Merchant Listing: Return Policy (Prevents GSC Warnings)
    "hasMerchantReturnPolicy": {
      "@type": "MerchantReturnPolicy",
      "applicableCountry": "IN",
      "returnPolicyCategory": "https://schema.org/MerchantReturnNotPermitted", // As per your hygiene refund policy
      "merchantReturnLink": `${siteConfig.url}/policies/refund-policy`
    }
  }
};
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": productFAQs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": { "@type": "Answer", "text": faq.a }
  }))
};
---

<BaseLayout title={title} description={description}>
  <!-- Inject Schemas -->
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>

  <div class="single-product-wrapper">
    
    <!-- SEO Breadcrumbs -->
    <nav class="breadcrumbs" aria-label="breadcrumb">
      <a href="/">Home</a> <span class="separator">›</span>
      <a href="/shop">Shop</a> <span class="separator">›</span>
      <a href={`/category/${categorySlug}`}>{product.category || 'Vapes'}</a> <span class="separator">›</span>
      <span class="current-page">{product.name}</span>
    </nav>

    <!-- Main Product Section -->
    <section class="product-main-layout">
      
      <!-- Left: Image Showcase -->
      <div class="product-gallery">
        <div class="main-image-box premium-glass-effect">
          {product.tags && product.tags[0] && (
            <span class="premium-badge">{product.tags[0]}</span>
          )}
          <span class="authenticity-seal">🛡️ Authentic</span>
          
          <div class="glow-backdrop"></div>
          {product.image && (product.image.includes('http') || product.image.includes('/')) ? (
            <img src={product.image} alt={product.name} class="product-img" />
          ) : (
            <div class="emoji-placeholder">{product.image || '💨'}</div>
          )}
        </div>
      </div>

      <!-- Right: Product Details & Variations -->
      <div class="product-info">
        <div class="brand-link">
          <a href={`/shop?brand=${(product.brand || '').toLowerCase()}`}>{product.brand || 'VAPEHYD'}</a>
        </div>
        
        <h1 class="product-title">{product.name}</h1>
        
        {product.short_description && (
           <p class="short-description">{product.short_description}</p>
        )}
        
        <div class="price-section">
          <span class="sale-price">₹{product.sale_price}</span>
          {product.regular_price && (
             <>
               <span class="regular-price">₹{product.regular_price}</span>
               <span class="discount-tag">Save ₹{product.regular_price - product.sale_price}</span>
             </>
          )}
        </div>

        <div class="trust-indicators">
          <div class="trust-item"><span class="icon">⚡</span> 30-Min Delivery in HYD</div>
          <div class="trust-item"><span class="icon">✅</span> 100% Genuine Product</div>
        </div>

        <!-- VARIATIONS SELECTION -->
        {flavorsArray.length > 0 && (
          <div class="variations-section">
            <h3 class="variation-title">Select Flavor: <span id="selected-flavor-text" class="selected-value">None</span></h3>
            <div class="flavor-grid">
              {flavorsArray.map((flavor: string) => (
                <button class="flavor-btn" data-flavor={flavor}>{flavor}</button>
              ))}
            </div>
            <p id="flavor-error" class="error-msg hidden">Please select a flavor to continue.</p>
          </div>
        )}

        <!-- Inline Action Buttons -->
        <div class="action-buttons-container">
          <button 
            id="add-to-cart-btn"
            class="action-btn premium-add-btn" 
            data-id={product.id} data-name={product.name} data-price={product.sale_price} data-image={product.image} data-has-flavors={flavorsArray.length > 0 ? "true" : "false"}
          >
            <span class="btn-content">ADD TO CART <span class="plus-icon">+</span></span>
          </button>
          
          <button id="whatsapp-buy-btn" class="action-btn wa-buy-btn" data-name={product.name} data-price={product.sale_price} data-whatsapp={siteConfig.whatsappNumber} data-has-flavors={flavorsArray.length > 0 ? "true" : "false"}>
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.82 9.82 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
            Order via WhatsApp
          </button>
        </div>

        <!-- Long Description Box -->
        <div class="description-box mt-4">
          <h3>Product Details</h3>
          <div class="long-description">
             {longDescription ? <div set:html={longDescription.replace(/\n/g, '<br/>')}></div> : <p>Premium quality product from VAPEHYD.</p>}
          </div>
          
          <div class="specs-table">
            {product.brand && (
              <div class="spec-row">
                <span class="spec-name">Brand</span>
                <span class="spec-value">{product.brand}</span>
              </div>
            )}
            {product.category && (
              <div class="spec-row">
                <span class="spec-name">Category</span>
                <span class="spec-value">{product.category}</span>
              </div>
            )}
            {product.puffs && (
               <div class="spec-row">
                  <span class="spec-name">Puffs</span>
                  <span class="spec-value">{product.puffs}</span>
               </div>
            )}
            <div class="spec-row">
              <span class="spec-name">Availability</span>
              <span class="spec-value text-green">In Stock</span>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- 🔥 NEW: DYNAMIC SEO FAQs FOR THIS PRODUCT -->
    <section class="product-faq-section">
      <div class="faq-container">
        <h2>Frequently Asked Questions about {product.name}</h2>
        <div class="accordion-wrapper">
          {productFAQs.map((faq) => (
            <div class="faq-item">
              <button class="faq-question">
                {faq.q} 
                <span class="icon">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </span>
              </button>
              <div class="faq-answer"><p>{faq.a}</p></div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 🔥 NEW: RELATED PRODUCTS MODULE -->
    {relatedProducts.length > 0 && (
      <section class="related-products">
        <div class="section-header">
          <h2>Similar Products</h2>
          <a href={`/category/${categorySlug}`} class="view-all">View All →</a>
        </div>
        <div class="grid-container">
          {relatedProducts.map((p) => (
            <ProductCard product={p} />
          ))}
        </div>
      </section>
    )}

  </div>
</BaseLayout>

<style>
  /* WRAPPER */
  .single-product-wrapper { max-width: 1200px; margin: 0 auto; padding: 0 16px 60px; font-family: system-ui, -apple-system, sans-serif; }
  @media (min-width: 768px) { .single-product-wrapper { padding: 0 24px 80px; } }

  .breadcrumbs { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; padding: 16px 0 24px; font-size: 0.85rem; color: #888; font-weight: 600; }
  .breadcrumbs a { color: #ff3e6c; text-decoration: none; }
  .current-page { color: #fff; }

  /* LAYOUT */
  .product-main-layout { display: flex; flex-direction: column; gap: 30px; margin-bottom: 40px; }
  @media (min-width: 992px) { .product-main-layout { flex-direction: row; gap: 50px; align-items: flex-start; } }

  /* GALLERY WITH PREMIUM GLASS GLOW */
  .product-gallery { width: 100%; }
  @media (min-width: 992px) { .product-gallery { width: 50%; position: sticky; top: 100px; } }
  
  .premium-glass-effect {
    position: relative; width: 100%; aspect-ratio: 1; 
    background: linear-gradient(145deg, rgba(30,30,30,0.6) 0%, rgba(10,10,10,0.9) 100%);
    border-radius: 24px; border: 1px solid rgba(255,255,255,0.08); 
    display: flex; justify-content: center; align-items: center; overflow: hidden;
    box-shadow: inset 0 0 40px rgba(0,0,0,0.8), 0 20px 40px rgba(0,0,0,0.5);
    backdrop-filter: blur(10px);
  }

  .glow-backdrop {
    position: absolute; width: 250px; height: 250px; 
    background: radial-gradient(circle, rgba(255, 62, 108, 0.15) 0%, rgba(0,0,0,0) 70%);
    filter: blur(40px); z-index: 0;
  }

  .product-img { 
    width: 100%; height: 100%; object-fit: contain; padding: 50px; 
    filter: drop-shadow(0 25px 35px rgba(0,0,0,0.8)); animation: floatImg 4s ease-in-out infinite; z-index: 2; position: relative;
  }
  @keyframes floatImg { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-15px); } }
  .emoji-placeholder { font-size: 5rem; filter: drop-shadow(0 10px 20px rgba(0,0,0,0.5)); z-index: 2;}

  .premium-badge { position: absolute; top: 16px; left: 16px; background: #ff3e6c; color: #fff; font-size: 0.75rem; font-weight: 800; padding: 6px 12px; border-radius: 12px; text-transform: uppercase; z-index: 10; box-shadow: 0 4px 10px rgba(255,62,108,0.4); }
  .authenticity-seal { position: absolute; top: 16px; right: 16px; background: rgba(255,255,255,0.1); backdrop-filter: blur(10px); color: #fff; font-size: 0.7rem; font-weight: 700; padding: 6px 12px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.2); z-index: 10; }

  /* INFO */
  .product-info { width: 100%; display: flex; flex-direction: column; }
  @media (min-width: 992px) { .product-info { width: 50%; padding-top: 20px; } }
  
  .brand-link a { color: #ff3e6c; text-decoration: none; font-size: 0.95rem; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; }
  .product-title { font-size: 1.8rem; color: #fff; margin: 8px 0 8px; font-weight: 800; line-height: 1.2; }
  @media (min-width: 768px) { .product-title { font-size: 2.8rem; margin-bottom: 12px; } }
  .short-description { color: #aaa; font-size: 0.95rem; line-height: 1.5; margin-bottom: 24px; }

  .price-section { display: flex; align-items: center; flex-wrap: wrap; gap: 12px; margin-bottom: 24px; padding-bottom: 24px; border-bottom: 1px solid rgba(255,255,255,0.1); }
  .sale-price { font-size: 2.5rem; color: #fff; font-weight: 900; line-height: 1; }
  .regular-price { font-size: 1.2rem; color: #666; text-decoration: line-through; font-weight: 600; margin-top: 8px; }
  .discount-tag { background: rgba(37,211,102,0.15); color: #25D366; padding: 4px 10px; border-radius: 8px; font-size: 0.85rem; font-weight: 800; margin-top: 8px; border: 1px solid rgba(37,211,102,0.3); }

  .trust-indicators { display: flex; flex-direction: column; gap: 12px; margin-bottom: 24px; }
  .trust-item { display: flex; align-items: center; gap: 10px; color: #ccc; font-size: 0.95rem; font-weight: 600; }

  /* VARIATIONS */
  .variations-section { margin-bottom: 30px; }
  .variation-title { color: #fff; font-size: 1.1rem; margin-bottom: 12px; font-weight: 700; }
  .selected-value { color: #ff3e6c; font-weight: 800; }
  .flavor-grid { display: flex; flex-wrap: wrap; gap: 10px; }
  .flavor-btn { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: #ccc; padding: 10px 16px; border-radius: 12px; font-size: 0.9rem; font-weight: 600; cursor: pointer; transition: all 0.2s; }
  .flavor-btn:hover { background: rgba(255,255,255,0.1); border-color: rgba(255,255,255,0.3); color: #fff; }
  .flavor-btn.active { background: rgba(255, 62, 108, 0.15); border-color: #ff3e6c; color: #ff3e6c; box-shadow: 0 0 10px rgba(255, 62, 108, 0.2); }
  .error-msg { color: #ff4444; font-size: 0.85rem; margin-top: 8px; font-weight: 600; }
  .hidden { display: none; }

  /* INLINE ACTION BUTTONS */
  .action-buttons-container { display: flex; flex-direction: column; gap: 12px; margin-bottom: 30px; }
  @media (min-width: 768px) { .action-buttons-container { flex-direction: row; } }
  
  .action-btn { display: flex; align-items: center; justify-content: center; padding: 16px 24px; border-radius: 16px; font-size: 1rem; font-weight: 800; cursor: pointer; transition: all 0.2s; text-decoration: none; border: none; flex: 1; gap: 8px;}
  .wa-buy-btn { background: #25D366; color: #000; box-shadow: 0 4px 15px rgba(37, 211, 102, 0.2); }
  .wa-buy-btn:hover { transform: translateY(-3px); box-shadow: 0 8px 25px rgba(37, 211, 102, 0.4); }
  
  .premium-add-btn { background: linear-gradient(135deg, rgba(255, 62, 108, 0.15) 0%, rgba(255, 62, 108, 0.05) 100%); color: #ff3e6c; border: 1px solid rgba(255, 62, 108, 0.3); }
  .premium-add-btn:hover { background: linear-gradient(135deg, #ff3e6c 0%, #e62c58 100%); color: white; border-color: transparent; box-shadow: 0 4px 15px rgba(255, 62, 108, 0.4); transform: translateY(-3px); }
  .btn-content { display: flex; justify-content: center; align-items: center; gap: 8px; }
  .success-state { background: linear-gradient(135deg, #25D366 0%, #1ebd5a 100%) !important; color: white !important; border-color: transparent !important; }

  /* DESCRIPTION BOX */
  .mt-4 { margin-top: 10px; }
  .description-box { background: #111; padding: 24px; border-radius: 16px; border: 1px solid rgba(255,255,255,0.05); }
  .description-box h3 { margin: 0 0 16px; color: #fff; font-size: 1.2rem; font-weight: 800; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 10px; }
  .long-description { color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 24px; }
  .long-description :global(p) { margin-bottom: 12px; }
  .long-description :global(ul) { margin-bottom: 16px; padding-left: 20px; }
  .long-description :global(li) { margin-bottom: 6px; }
  .long-description :global(strong) { color: #eee; }

  .specs-table { display: flex; flex-direction: column; border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; overflow: hidden; }
  .spec-row { display: flex; border-bottom: 1px solid rgba(255,255,255,0.1); }
  .spec-row:last-child { border-bottom: none; }
  .spec-name { width: 40%; background: #1a1a1a; padding: 12px; color: #888; font-size: 0.9rem; font-weight: 600; }
  .spec-value { width: 60%; padding: 12px; color: #fff; font-size: 0.9rem; font-weight: 500; }
  .text-green { color: #25D366; font-weight: 700; }

  /* --- 🔥 DYNAMIC FAQs CSS --- */
  .product-faq-section { margin-top: 20px; margin-bottom: 60px;}
  .faq-container { background: #111; border: 1px solid rgba(255,255,255,0.05); border-radius: 20px; padding: 24px; }
  .faq-container h2 { color: #fff; font-size: 1.3rem; margin: 0 0 20px; font-weight: 800; }
  .accordion-wrapper { display: flex; flex-direction: column; gap: 10px; }
  .faq-item { background: #141414; border: 1px solid rgba(255,255,255,0.05); border-radius: 12px; overflow: hidden; }
  .faq-question { width: 100%; background: none; border: none; padding: 16px 20px; color: #fff; font-size: 0.95rem; font-weight: 600; text-align: left; cursor: pointer; display: flex; justify-content: space-between; align-items: center; line-height: 1.4; }
  .faq-question .icon { transition: transform 0.3s; color: #ff3e6c; flex-shrink: 0; }
  .faq-answer { max-height: 0; overflow: hidden; transition: max-height 0.3s ease; padding: 0 20px; }
  .faq-answer p { margin: 0 0 16px; font-size: 0.9rem; line-height: 1.6; color: #aaa; }
  .faq-item.active .faq-answer { max-height: 300px; }
  .faq-item.active .faq-question .icon { transform: rotate(180deg); }

  /* --- 🔥 RELATED PRODUCTS CSS --- */
  .related-products { padding-top: 40px; border-top: 1px solid rgba(255,255,255,0.1); }
  .section-header { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 20px; }
  .section-header h2 { color: #fff; margin: 0; font-size: 1.5rem; font-weight: 800; }
  .view-all { color: #ff3e6c; text-decoration: none; font-weight: 700; font-size: 0.9rem; }
  .grid-container { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
  @media (min-width: 768px) { .grid-container { grid-template-columns: repeat(4, 1fr); gap: 20px; } }
</style>

<style is:global>
  @keyframes popIn { 0% { transform: scale(0.5); opacity: 0; } 80% { transform: scale(1.2); opacity: 1; } 100% { transform: scale(1); opacity: 1; } }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    
    // --- FLAVOR SELECTION LOGIC ---
    const flavorBtns = document.querySelectorAll('.flavor-btn');
    const selectedFlavorText = document.getElementById('selected-flavor-text');
    const errorMsg = document.getElementById('flavor-error');
    let currentSelectedFlavor = '';

    flavorBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        flavorBtns.forEach(b => b.classList.remove('active'));
        const target = e.target as HTMLElement;
        target.classList.add('active');
        currentSelectedFlavor = target.dataset.flavor || '';
        if(selectedFlavorText) selectedFlavorText.innerText = currentSelectedFlavor;
        if(errorMsg) errorMsg.classList.add('hidden');
      });
    });

    // --- ADD TO CART LOGIC ---
    const addToCartBtn = document.getElementById('add-to-cart-btn');
    addToCartBtn?.addEventListener('click', (e) => {
      const btn = e.currentTarget as HTMLElement;
      const hasFlavors = btn.dataset.hasFlavors === "true";

      if (hasFlavors && !currentSelectedFlavor) {
        if(errorMsg) errorMsg.classList.remove('hidden');
        const variationSection = document.querySelector('.variations-section');
        if (variationSection) {
            variationSection.animate([ { transform: 'translateX(-5px)' }, { transform: 'translateX(5px)' }, { transform: 'translateX(0)' } ], { duration: 300 });
        }
        return; 
      }

      if (window.navigator && window.navigator.vibrate) window.navigator.vibrate(50);
      try {
        const ctx = new (window.AudioContext || window.webkitAudioContext)();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.connect(gain); gain.connect(ctx.destination);
        osc.type = 'sine';
        osc.frequency.setValueAtTime(1200, ctx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(300, ctx.currentTime + 0.03); 
        gain.gain.setValueAtTime(0.1, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.03); 
        osc.start(ctx.currentTime); osc.stop(ctx.currentTime + 0.03);
      } catch(err) {}

      const baseId = btn.dataset.id;
      const productName = btn.dataset.name;
      const finalId = hasFlavors ? `${baseId}-${currentSelectedFlavor.replace(/\s+/g, '-').toLowerCase()}` : baseId;
      const finalName = hasFlavors ? `${productName} (${currentSelectedFlavor})` : productName;

      const product = { 
        id: finalId, 
        name: finalName, 
        price: parseInt(btn.dataset.price || '0'), 
        image: btn.dataset.image, 
        quantity: 1 
      };

      let cart = JSON.parse(localStorage.getItem('vapeCart') || '[]');
      const existingItem = cart.find((item: any) => item.id === product.id);
      if (existingItem) existingItem.quantity += 1; else cart.push(product);
      localStorage.setItem('vapeCart', JSON.stringify(cart));
      window.dispatchEvent(new Event('cartUpdated'));

      const btnContent = btn.querySelector('.btn-content');
      if(btnContent) {
        const originalHTML = btnContent.innerHTML;
        btn.classList.add('success-state');
        btnContent.innerHTML = `<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="animation: popIn 0.3s ease;"><polyline points="20 6 9 17 4 12"></polyline></svg> ADDED`;
        setTimeout(() => { btn.classList.remove('success-state'); btnContent.innerHTML = originalHTML; }, 1000);
      }
    });

    // --- WHATSAPP BUY NOW LOGIC ---
    const waBtn = document.getElementById('whatsapp-buy-btn');
    waBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      const btn = e.currentTarget as HTMLElement;
      const hasFlavors = btn.dataset.hasFlavors === "true";

      if (hasFlavors && !currentSelectedFlavor) {
        if(errorMsg) errorMsg.classList.remove('hidden');
        return; 
      }

      const productName = btn.dataset.name;
      const price = btn.dataset.price;
      const waNumber = btn.dataset.whatsapp;
      
      const flavorText = hasFlavors ? `\nFlavor: *${currentSelectedFlavor}*` : '';
      const waMsg = encodeURIComponent(`Hi, I want to buy:\n\n*${productName}*${flavorText}\nPrice: ₹${price}\n\nIs this available for 30-min express delivery?`);
      
      window.open(`https://wa.me/${waNumber}?text=${waMsg}`, '_blank');
    });

    // --- 🔥 FAQ ACCORDION LOGIC ---
    document.querySelectorAll('.faq-question').forEach(btn => {
      btn.addEventListener('click', () => {
        const item = btn.parentElement;
        if(item) item.classList.toggle('active');
      });
    });

  });
</script>