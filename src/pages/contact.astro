---
// src/pages/contact.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site.js';

const title = "Contact Us | Fast Support & Delivery in Hyderabad";
const description = "Need help with your vape order? Contact VAPEHYD for instant WhatsApp support, delivery tracking, and wholesale inquiries in Hyderabad.";

// SEO ContactPage Schema
const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contact VAPEHYD",
  "description": description,
  "url": `${siteConfig.url}/contact`,
  "mainEntity": {
    "@type": "LocalBusiness",
    "name": "VAPEHYD Support",
    "telephone": siteConfig.whatsappNumber,
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Hyderabad",
      "addressRegion": "Telangana",
      "addressCountry": "IN"
    }
  }
};

const waMsg = encodeURIComponent("Hi VAPEHYD Support, I need some help regarding an order/product.");
const waLink = `https://wa.me/${siteConfig.whatsappNumber}?text=${waMsg}`;
---

<BaseLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(contactSchema)}></script>

  <div class="contact-wrapper">
    
    <div class="contact-header">
      <h1 class="page-title">Get in <span class="highlight">Touch</span></h1>
      <p class="subtitle">Have a question about a product, delivery, or authenticity? Our local Hyderabad support team is ready to help you instantly.</p>
    </div>

    <div class="contact-grid">
      
      <!-- Contact Info Cards -->
      <div class="contact-info">
        <a href={waLink} target="_blank" rel="noopener noreferrer" class="info-card whatsapp-card">
          <div class="icon-circle wa-bg"><svg viewBox="0 0 24 24" width="24" height="24" fill="#fff"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.82 9.82 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg></div>
          <div class="info-text">
            <h3>WhatsApp Us</h3>
            <p>Instant replies in 2 mins</p>
            <span class="direct-link">Click to Chat →</span>
          </div>
        </a>

        <div class="info-card glass">
          <div class="icon-circle"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg></div>
          <div class="info-text">
            <h3>Email Support</h3>
            <p>support@vapehyd.in</p>
          </div>
        </div>

        <div class="info-card glass">
          <div class="icon-circle"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg></div>
          <div class="info-text">
            <h3>Dispatch Center</h3>
            <p>Hyderabad, Telangana, India<br/><small>(Online Dispatch Only. No walk-ins)</small></p>
          </div>
        </div>
      </div>

      <!-- Quick Message Form -->
      <div class="contact-form-box glass-card">
        <h2>Drop a Message</h2>
        <form class="premium-form" onsubmit="event.preventDefault(); alert('Thanks for your message! Our team will get back to you shortly.');">
          <div class="input-group">
            <label>Your Name</label>
            <input type="text" placeholder="John Doe" required />
          </div>
          <div class="input-group">
            <label>Email Address</label>
            <input type="email" placeholder="john@example.com" required />
          </div>
          <div class="input-group">
            <label>How can we help?</label>
            <textarea rows="4" placeholder="Type your message here..." required></textarea>
          </div>
          <button type="submit" class="submit-btn">Send Message</button>
        </form>
      </div>

    </div>
  </div>
</BaseLayout>

<style>
  .contact-wrapper { max-width: 1200px; margin: 0 auto; padding: 60px 16px 100px; font-family: system-ui, -apple-system, sans-serif; }
  
  .contact-header { text-align: center; margin-bottom: 50px; }
  .page-title { font-size: 2.5rem; color: #fff; margin: 0 0 16px; font-weight: 900; line-height: 1.2; }
  @media (min-width: 768px) { .page-title { font-size: 4rem; } }
  .highlight { color: #ff3e6c; text-shadow: 0 0 20px rgba(255,62,108,0.4); }
  .subtitle { color: #aaa; font-size: 1.05rem; max-width: 600px; margin: 0 auto; line-height: 1.6; }

  .contact-grid { display: grid; grid-template-columns: 1fr; gap: 40px; }
  @media (min-width: 992px) { .contact-grid { grid-template-columns: 1fr 1.2fr; gap: 60px; align-items: start; } }

  .contact-info { display: flex; flex-direction: column; gap: 20px; }
  .info-card { display: flex; align-items: center; gap: 20px; padding: 24px; border-radius: 20px; text-decoration: none; transition: transform 0.3s; }
  .info-card:hover { transform: translateY(-5px); }
  .glass { background: rgba(20,20,20,0.8); border: 1px solid rgba(255,255,255,0.05); }
  
  .whatsapp-card { background: linear-gradient(135deg, rgba(37,211,102,0.15) 0%, rgba(37,211,102,0.05) 100%); border: 1px solid rgba(37,211,102,0.3); }
  .whatsapp-card:hover { background: rgba(37,211,102,0.2); box-shadow: 0 10px 30px rgba(37,211,102,0.2); }
  
  .icon-circle { width: 50px; height: 50px; border-radius: 50%; display: flex; justify-content: center; align-items: center; background: rgba(255,255,255,0.05); color: #ff3e6c; flex-shrink: 0; }
  .wa-bg { background: #25D366; color: #fff; box-shadow: 0 4px 15px rgba(37,211,102,0.4); }
  
  .info-text h3 { color: #fff; margin: 0 0 6px; font-size: 1.1rem; font-weight: 700; }
  .info-text p { color: #888; margin: 0; font-size: 0.9rem; line-height: 1.5; }
  .direct-link { color: #25D366; font-size: 0.85rem; font-weight: 800; display: inline-block; margin-top: 8px; }

  .glass-card { background: linear-gradient(145deg, rgba(20,20,20,0.8) 0%, rgba(10,10,10,0.9) 100%); border: 1px solid rgba(255,255,255,0.05); padding: 40px; border-radius: 24px; box-shadow: 0 10px 30px rgba(0,0,0,0.5); backdrop-filter: blur(10px); }
  .contact-form-box h2 { color: #fff; font-size: 1.8rem; margin: 0 0 30px; font-weight: 800; }
  
  .premium-form { display: flex; flex-direction: column; gap: 20px; }
  .input-group { display: flex; flex-direction: column; gap: 8px; }
  .input-group label { color: #ccc; font-size: 0.85rem; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; }
  .input-group input, .input-group textarea { background: rgba(0,0,0,0.5); border: 1px solid rgba(255,255,255,0.1); padding: 16px; border-radius: 12px; color: #fff; font-size: 1rem; font-family: inherit; outline: none; transition: border-color 0.3s; }
  .input-group input:focus, .input-group textarea:focus { border-color: #ff3e6c; background: rgba(255, 62, 108, 0.05); }
  
  .submit-btn { background: #ff3e6c; color: #fff; border: none; padding: 18px; border-radius: 12px; font-size: 1rem; font-weight: 800; cursor: pointer; transition: all 0.3s; margin-top: 10px; box-shadow: 0 4px 15px rgba(255,62,108,0.4); }
  .submit-btn:hover { background: #e62c58; transform: translateY(-2px); box-shadow: 0 8px 25px rgba(255,62,108,0.6); }
</style>