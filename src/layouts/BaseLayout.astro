---
// src/layouts/BaseLayout.astro
import { SEO } from 'astro-seo';
import { siteConfig } from '../config/site.js';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppLeadPopup from '../components/WhatsAppLeadPopup.astro';
import MobileBottomNav from '../components/MobileBottomNav.astro';

// Page se title, description aur image props receive kar rahe hain
const { title, description, image } = Astro.props;

// Canonical URL banana (Duplicate content error rokne ke liye)
const canonicalURL = new URL(Astro.url.pathname, Astro.site || siteConfig.url).toString();

const pageTitle = title ? `${title} | ${siteConfig.name}` : siteConfig.name;
const ogImage = image ? new URL(image, Astro.site || siteConfig.url).toString() : `${siteConfig.url}/og-image.jpg`;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    
    <!-- 🔥 Naya Favicon aur Sitemap Link -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    
    <!-- Advanced SEO injected by astro-seo -->
    <SEO
      title={pageTitle}
      description={description || siteConfig.defaultDescription}
      canonical={canonicalURL}
      openGraph={{
        basic: {
          title: pageTitle,
          type: "website",
          image: ogImage,
        }
      }}
      extend={{
        meta: [{ name: "robots", content: "index, follow" }]
      }}
    />
    <slot name="head" />
  </head>
  <body style="margin: 0; background-color: #050505; color: #ffffff; padding-bottom: 90px; box-sizing: border-box;">
    
    <Header />
    
    <main>
      <slot /> 
    </main>

    <!-- Global Cart State Manager -->
    <script>
      function updateCartBadge() {
        const cart = JSON.parse(localStorage.getItem('vapeCart')) || [];
        let totalCount = 0;
        cart.forEach(item => totalCount += item.quantity);
        
        const countBadge = document.getElementById('cart-count');
        if (countBadge) {
          countBadge.innerText = totalCount;
          countBadge.style.display = totalCount > 0 ? 'flex' : 'none';
        }
      }
      
      updateCartBadge();
      window.addEventListener('cartUpdated', updateCartBadge);
    </script>

    <Footer />
    <WhatsAppLeadPopup />
    <MobileBottomNav />

  </body>
</html>